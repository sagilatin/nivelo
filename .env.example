# Copy to `.env.local` and fill in. Never commit `.env.local` — it's gitignored.
#
# In production, set the same values in:
#   Vercel → your project → Settings → Environment Variables.
# Make sure the VITE_* ones are exposed to the browser, and the rest are server-only.

# ─── Public (browser-safe) ──────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Server-only (Vercel functions) ─────────────────────────────────
# Same URL as above — duplicated for clarity in the cron function.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role key from Supabase → Settings → API → service_role.
# THIS BYPASSES RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Gemini API — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# DeepL Free — https://www.deepl.com/pro-api (Free tier, no card)
DEEPL_API_KEY=xxx-xxx-xxx:fx

# Random string. Used to manually trigger the cron from the browser:
#   curl 'https://your-app.vercel.app/api/cron/refresh?token=abc123'
CRON_TOKEN=change-me-to-anything-random
